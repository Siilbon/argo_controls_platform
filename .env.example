# .env.example

# Flask
# development, testing, or production (the default when unset)
FLASK_CONFIG=development
FLASK_DEBUG=False
FLASK_APP=app.py
SECRET_KEY=

# Database
# For SQLite (dev): path is relative to the auto-created instance/ folder
# For Postgres (prod): postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///data.sqlite
DEV_DATABASE_URL=sqlite:///data.sqlite
TEST_DATABASE_URL=sqlite:///test.sqlite

# Sign-in: refuse API requests without a Windows Authentication user.
# On by default in production, off otherwise.
# REQUIRE_AUTH=false

# Rotating log file for warnings and errors (unset logs to the console only)
# LOG_FILE=logs/acp.log

# Aspen
ASPEN_SERVER=
# ASPEN_TIMEOUT=60
# ASPEN_SEARCH_MAX_ROWS=5000
# ASPEN_RATE_LIMIT=30 per minute

# Frontend
# Built React app Flask serves; defaults to frontend/dist
# FRONTEND_DIST=

# CORS — allowed origins for the Flask API (comma-separated). Only the Vite dev
# server needs this (development defaults to it); in production Flask serves
# the frontend itself.
CORS_ORIGINS=http://localhost:5173
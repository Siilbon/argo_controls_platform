# .env.example

# Flask
FLASK_CONFIG=development
FLASK_DEBUG=False
FLASK_APP=app.py
SECRET_KEY=

# Database
# For SQLite (dev): path is relative to the auto-created instance/ folder
# For Postgres (prod): postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///data.sqlite
DEV_DATABASE_URL=sqlite:///data.sqlite
TEST_DATABASE_URL=sqlite:///test.sqlite

# External services
ASPEN_SERVER=

# Frontend (Vite / React)
VITE_API_URL=http://localhost:5000

# CORS — allowed origins for the Flask API (comma-separated)
CORS_ORIGINS=http://localhost:5173
<configuration>
  <system.webServer>
    <handlers>
      <!-- Update both paths for the server's Python install. wfastcgi is kept
           because it passes the Windows Authentication user (REMOTE_USER) to Flask. -->
      <remove name="Python FastCGI" />
      <add name="ACP FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\apps\argo_controls_platform\.venv\Scripts\python.exe|C:\apps\argo_controls_platform\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script"
           />
    </handlers>

    <!-- Only signed-in domain users reach the app. These sections are locked by
         default: install the Windows Authentication role service, then unlock
         them once per server (as admin):
           %windir%\system32\inetsrv\appcmd unlock config -section:system.webServer/security/authentication/windowsAuthentication
           %windir%\system32\inetsrv\appcmd unlock config -section:system.webServer/security/authentication/anonymousAuthentication
         Otherwise IIS answers every request with error 500.19. -->
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
  </system.webServer>

  <appSettings>
    <!-- wfastcgi turns these into environment variables. Keep secrets such as
         SECRET_KEY and DATABASE_URL out of this file; set them on the server. -->
    <add key="WSGI_HANDLER" value="app.app" />
    <add key="PYTHONPATH" value="C:\apps\argo_controls_platform"/>
    <add key="FLASK_CONFIG" value="production" />
    <add key="LOG_FILE" value="C:\apps\argo_controls_platform\logs\acp.log" />
  </appSettings>
</configuration>
